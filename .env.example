# ---------- Models & media (all optional; unset slots are auto-detected from keys) ----------
# Failover chains: comma-separated provider[:arg][@model]   (docs/provider-limits.md)
# VIDSK_LLM=anthropic:claude-sonnet-5-5,openai:gpt-5,ollama:llama3.1
# VIDSK_LLM_FAST=anthropic:claude-haiku-5-5
# VIDSK_TTS=kokoro:am_michael            # or elevenlabs:<voiceId>@eleven_multilingual_v2, openai:onyx, cartesia:<id>, google:<voice>, azure:<voice>, deepgram:<model>, compat:<url>#<model>
# VIDSK_STT=groq                          # openai | groq | deepgram | elevenlabs | workers-ai | compat:<url>#<model>
# VIDSK_MUSIC=elevenlabs                  # stability | fal:<model> | replicate:<model> | none
# VIDSK_SFX=elevenlabs,freesound,openverse   # always ends in procedural foley
# VIDSK_STOCK=pexels,pixabay,unsplash,openverse,wikimedia
# VIDSK_IMAGE=openai,imagen               # workers-ai | fal:<model> | replicate:<model>
# VIDSK_VIDEO=fal:<text-to-video-model>
# VIDSK_RESEARCH=tavily,wikipedia         # exa | brave | searxng | none
# VIDSK_RENDER=http:https://render.example.com

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
KOKORO_BASE_URL=            # Kokoro-FastAPI, e.g. http://localhost:8880 (CLI falls back to local `hyperframes tts`)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
DEEPGRAM_API_KEY=
STABILITY_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
FREESOUND_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=
TAVILY_API_KEY=
EXA_API_KEY=
BRAVE_API_KEY=
JINA_API_KEY=

# ---------- Publishing (only the platforms you fill in are enabled) ----------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY=public
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_MODE=direct          # direct | inbox (draft)
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REFRESH_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=        # urn:li:person:xxx or urn:li:organization:xxx
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
PUBLISH_WEBHOOK_URL=        # Zapier / Make / n8n / Buffer / Ayrshare hand-off
PUBLISH_WEBHOOK_SECRET=

# ---------- Server ----------
VIDSK_API_TOKEN=            # bearer token for `vidsk serve` and the Worker
