        "musicCue": "drop",
        "lines": [
          {
            "id": "l3",
            "text": "Families build ofrendas. Altars with photos of their loved ones, and their favorite foods and drinks.",
            "emphasis": [
              "favorite"
            ],
            "claimIds": [
              "c3"
            ],
            "pauseAfterSec": 0.3
          },
          {
            "id": "l4",
            "text": "Bright marigolds line the way. Their strong scent is said to guide souls home from the cemetery.",
            "emphasis": [
              "home"
            ],
            "claimIds": [
              "c4"
            ],
            "pauseAfterSec": 0.35
          },
          {
            "id": "l5",
            "text": "Sugar skulls aren't meant to be scary. Their colors stand for the person's life and personality.",
            "emphasis": [
              "personality"
            ],
            "claimIds": [
              "c5"
            ],
            "pauseAfterSec": 0.4
          }
        ]
      },
      {
        "id": "b3",
        "kind": "twist",
        "musicCue": "none",
        "lines": [
          {
            "id": "l6",
            "text": "And the famous skeleton lady, La Catrina? She started as satire.",
            "emphasis": [
              "satire"
            ],
            "claimIds": [
              "c6"
            ],
            "pauseAfterSec": 0.25
          },
          {
            "id": "l7",
            "text": "Around 1910, printmaker José Guadalupe Posada drew her to mock Mexico's upper class.",
            "emphasis": [
              "mock"
            ],
            "claimIds": [
              "c6"
            ],
            "pauseAfterSec": 0.3
          },
          {
            "id": "l8",
            "text": "Diego Rivera later painted her into a giant mural, and she became an icon.",
            "emphasis": [
              "icon"
            ],
            "claimIds": [
              "c7"
            ],
            "pauseAfterSec": 0.4
          }
        ]
      },
      {
        "id": "b4",
        "kind": "proof",
        "musicCue": "none",
        "lines": [
          {
            "id": "l9",
            "text": "In 2008, UNESCO added the tradition to its list of the world's cultural heritage.",
            "emphasis": [
              "heritage"
            ],
            "claimIds": [
              "c8"
            ],
            "pauseAfterSec": 0.4
          }
        ]
      },
