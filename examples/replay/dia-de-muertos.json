{
  "ResearchDossier": {
    "topic": "Día de los Muertos explained",
    "summary": "Day of the Dead, on 1 and 2 November, emphasises celebration and collective memory. Families build ofrendas with photos and favourite foods; marigolds' scent is believed to guide souls home; sugar skulls represent the personality of the departed. La Catrina began as Posada's satirical etching (c. 1910–12) and became an icon via Rivera's 1946–47 mural. UNESCO listed the tradition in 2008.",
    "angle": "It's not a night to fear the dead. It's a night to welcome them home.",
    "claims": [
      {
        "id": "c1",
        "text": "Day of the Dead is traditionally celebrated on November 1 and 2.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Day_of_the_Dead",
            "title": "Day of the Dead - Wikipedia",
            "quote": "traditionally celebrated on November 1 and 2"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c2",
        "text": "The holiday is characterised by remembrance activities that emphasise celebration and collective memory.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Day_of_the_Dead",
            "title": "Day of the Dead - Wikipedia",
            "quote": "characterised by remembrance activities that emphasise celebration and collective memory"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c3",
        "text": "Ofrendas (altars) contain the favorite foods and beverages, as well as photos and memorabilia, of the departed.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Day_of_the_Dead",
            "title": "Day of the Dead - Wikipedia",
            "quote": "containing the favorite foods and beverages, as well as photos and memorabilia, of the departed"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c4",
        "text": "The bright petals of marigolds, with a strong scent, are believed to guide the souls from cemeteries to their family homes.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Day_of_the_Dead",
            "title": "Day of the Dead - Wikipedia",
            "quote": "the bright petals with a strong scent can guide the souls from cemeteries to their family homes"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c5",
        "text": "Calaveras, or sugar skulls, display colorful designs to represent the vitality and individual personality of the departed.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Day_of_the_Dead",
            "title": "Day of the Dead - Wikipedia",
            "quote": "Calaveras, or sugar skulls, display colorful designs to represent the vitality and individual personality of the departed."
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c6",
        "text": "La Calavera Catrina is a zinc etching by José Guadalupe Posada, usually dated c. 1910–12, intended to satirize upper class women of the Porfiriato.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/La_Calavera_Catrina",
            "title": "La Calavera Catrina - Wikipedia",
            "quote": "intended to satirize upper class women of the Porfiriato"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c7",
        "text": "In 1946–47 Diego Rivera elaborated Posada's creation into a full-scale figure in his mural; Catrina is now a ubiquitous character associated with Day of the Dead.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/La_Calavera_Catrina",
            "title": "La Calavera Catrina - Wikipedia",
            "quote": "elaborated Posada's creation into a full-scale figure"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c8",
        "text": "In 2008 the tradition was added to UNESCO's Representative List of the Intangible Cultural Heritage of Humanity.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Day_of_the_Dead",
            "title": "Day of the Dead - Wikipedia",
            "quote": "In 2008, the tradition was added to the Representative List of the Intangible Cultural Heritage of Humanity"
          }
        ],
        "confidence": "high"
      }
    ],
