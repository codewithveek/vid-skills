            ],
            "pauseAfterSec": 0.5
          }
        ]
      },
      {
        "id": "b3",
        "kind": "history",
        "musicCue": "none",
        "lines": [
          {
            "id": "l5",
            "text": "In 2011, two scientists in Italy watched 109 adults yawn in their everyday lives, for a whole year.",
            "emphasis": [
              "109"
            ],
            "claimIds": [
              "c2"
            ],
            "pauseAfterSec": 0.35
          },
          {
            "id": "l6",
            "text": "They studied 480 yawns, and who yawned back.",
            "emphasis": [
              "480"
            ],
            "claimIds": [
              "c2"
            ],
            "pauseAfterSec": 0.45
          }
        ]
      },
      {
        "id": "b4",
        "kind": "mechanism",
        "musicCue": "none",
        "lines": [
          {
            "id": "l7",
            "text": "Yawns spread most between family. Then friends. Then acquaintances.",
            "emphasis": [
              "family."
            ],
            "claimIds": [
              "c3"
            ],
            "pauseAfterSec": 0.35
          },
          {
            "id": "l8",
            "text": "Strangers caught them least, and took the longest to yawn back.",
            "emphasis": [
              "Strangers"
            ],
            "claimIds": [
              "c3",
              "c4"
            ],
            "pauseAfterSec": 0.45
          },
          {
            "id": "l9",
            "text": "Gender didn't predict it. Neither did nationality.",
            "emphasis": [
              "Gender"
            ],
            "claimIds": [
              "c5"
            ],
            "pauseAfterSec": 0.3
          },
          {
            "id": "l10",
            "text": "Only closeness did.",
            "emphasis": [
              "closeness"
            ],
            "claimIds": [
              "c5"
            ],
            "pauseAfterSec": 0.45
          },
          {
            "id": "l11",
            "text": "And it worked just as well when people only heard the yawn.",
            "emphasis": [
              "heard"
            ],
            "claimIds": [
              "c6"
            ],
            "pauseAfterSec": 0.5
          }
        ]
      },
      {
        "id": "b5",
        "kind": "twist",
        "musicCue": "drop",
        "lines": [
          {
            "id": "l12",
            "text": "Here's the strangest part. Dogs catch our yawns too.",
            "emphasis": [
