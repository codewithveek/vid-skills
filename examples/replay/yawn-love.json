{
  "ResearchDossier": {
    "topic": "your yawn knows who you love",
    "summary": "Contagious yawning spreads most between kin, then friends, then acquaintances, then strangers (Norscia & Palagi 2011, 109 adults, 480 bouts, one year of observation); strangers are slower to yawn back; gender and nationality do not predict it; hearing a yawn works as well as seeing one. Dogs catch human yawns (21 of 29 in Joly-Mascheroni 2008). A larger 2014 study (328 people) found age, not empathy, predicted susceptibility. Reading or thinking about yawning can trigger yawns (Provine).",
    "angle": "Who catches your yawn says how close you are.",
    "claims": [
      {
        "id": "c1",
        "text": "Yawns are so infectious that simply reading or thinking about them can trigger a yawn.",
        "sources": [
          {
            "url": "https://www.americanscientist.org/sites/americanscientist.org/files/200510314450_646.pdf",
            "title": "Provine (2005) Yawning. American Scientist",
            "quote": "simply reading or thinking about them can be the vector of an infectious response"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c2",
        "text": "Norscia and Palagi observed 109 adults (over 16) yawning in their natural settings over one year; 480 yawning bouts were analysed.",
        "sources": [
          {
            "url": "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0028472",
            "title": "Norscia & Palagi (2011) Yawn Contagion and Empathy in Homo sapiens. PLOS ONE",
            "quote": "involved 109 adults"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c3",
        "text": "Yawn contagion was greatest in response to kin, then friends, then acquaintances, and lastly strangers.",
        "sources": [
          {
            "url": "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0028472",
            "title": "Norscia & Palagi (2011) Yawn Contagion and Empathy in Homo sapiens. PLOS ONE",
            "quote": "the rate of contagion was greatest in response to kin, then friends, then acquaintances, and lastly strangers"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c4",
        "text": "Strangers and acquaintances showed a longer delay in yawning back than friends and kin.",
        "sources": [
          {
            "url": "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0028472",
            "title": "Norscia & Palagi (2011) Yawn Contagion and Empathy in Homo sapiens. PLOS ONE",
            "quote": "Strangers and acquaintances showed a longer delay in the yawn response"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c5",
        "text": "Yawn contagion was driven by emotional closeness, not by gender or nationality.",
        "sources": [
          {
            "url": "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0028472",
            "title": "Norscia & Palagi (2011) Yawn Contagion and Empathy in Homo sapiens. PLOS ONE",
            "quote": "and not by other variables, such as gender and nationality"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c6",
        "text": "Sensory modality (seeing or only hearing the yawn) did not affect contagion.",
        "sources": [
          {
            "url": "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0028472",
            "title": "Norscia & Palagi (2011) Yawn Contagion and Empathy in Homo sapiens. PLOS ONE",
            "quote": "sensory modality did not affect contagion"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c7",
        "text": "In a 2008 experiment, 21 of 29 dogs yawned after watching a stranger yawn; none yawned in the control condition.",
        "sources": [
          {
            "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC2610100",
            "title": "Joly-Mascheroni, Senju & Shepherd (2008) Dogs catch human yawns. Biology Letters",
            "quote": "21 out of 29 dogs"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c8",
        "text": "A 2014 study of 328 people found age was the only factor that independently predicted contagious yawning; empathy did not.",
        "sources": [
          {
            "url": "https://pmc.ncbi.nlm.nih.gov/articles/PMC3954725",
            "title": "Bartholomew & Cirulli (2014) Individual variation in contagious yawning susceptibility. PLOS ONE",
            "quote": "age"
          }
        ],
        "confidence": "medium"
      }
    ],
