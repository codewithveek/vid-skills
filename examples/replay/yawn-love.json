            ],
            "claimIds": [
              "c7"
            ],
            "pauseAfterSec": 0.35
          },
          {
            "id": "l13",
            "text": "In one study, 21 of 29 dogs yawned after watching a stranger yawn.",
            "emphasis": [
              "21"
            ],
            "claimIds": [
              "c7"
            ],
            "pauseAfterSec": 0.5
          }
        ]
      },
      {
        "id": "b6",
        "kind": "proof",
        "musicCue": "none",
        "lines": [
          {
            "id": "l14",
            "text": "Scientists still argue about why.",
