{
  "ResearchDossier": {
    "topic": "why jeans have tiny metal rivets on the pockets",
    "summary": "The copper rivets on jeans are a patented fix from 1873: a Reno tailor reinforced a woodcutter's work pants, then partnered with his fabric supplier, Levi Strauss, to patent it. The tiny watch pocket came a few years later.",
    "angle": "The little metal studs you never look at are a 150-year-old patent that started with one woodcutter's pants.",
    "claims": [
      {
        "id": "c1",
        "text": "Jacob W. Davis opened a tailor shop in Reno, Nevada in 1869.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Jacob_W._Davis",
            "title": "Jacob W. Davis - Wikipedia",
            "quote": "a tailor shop in the main street of the town"
          }
        ],
        "confidence": "medium"
      },
      {
        "id": "c2",
        "text": "In December 1870 a customer asked Davis to make a pair of strong working pants for her husband, a woodcutter.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Jacob_W._Davis",
            "title": "Jacob W. Davis - Wikipedia",
            "quote": "a pair of strong working pants for her husband who was a woodcutter"
          }
        ],
        "confidence": "medium"
      },
      {
        "id": "c3",
        "text": "Copper rivets reinforced the points of stress, such as pocket corners and the bottom of the button fly.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Jeans",
            "title": "Jeans - Wikipedia",
            "quote": "The copper rivets were to reinforce the points of stress, such as pocket corners and at the bottom of the button fly."
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c4",
        "text": "Davis wanted financial backing for a patent and wrote to Levi Strauss, his fabric supplier, in 1872; Strauss accepted.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Jeans",
            "title": "Jeans - Wikipedia",
            "quote": "In 1872, Davis wrote to Strauss asking to partner with him to patent and sell clothing reinforced with rivets."
          },
          {
            "url": "https://en.wikipedia.org/wiki/Jacob_W._Davis",
            "title": "Jacob W. Davis - Wikipedia"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c5",
        "text": "On May 20, 1873, Davis and Strauss received US patent No. 139,121 for an 'Improvement in Fastening Pocket-Openings'.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Jeans",
            "title": "Jeans - Wikipedia",
            "quote": "received US patent No. 139,121 for an \"Improvement in Fastening Pocket-Openings\" on May 20, 1873"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c6",
        "text": "The small riveted watch pocket was first added by Levi Strauss to their jeans in the late 1870s.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Jeans",
            "title": "Jeans - Wikipedia",
            "quote": "The small riveted watch pocket was first added by Levi Strauss to their jeans in the late 1870s."
          },
          {
            "url": "https://en.wikipedia.org/wiki/Watch_pocket",
            "title": "Watch pocket - Wikipedia",
            "quote": "originally for holding a pocket watch"
          }
        ],
        "confidence": "high"
      }
    ],
