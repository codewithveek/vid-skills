   },
   {
    "id": "c2",
    "text": "A police constable operated the signal, using a lever at night to show a red or green light.",
    "sources": [
     {
      "url": "https://en.wikipedia.org/wiki/Traffic_light",
      "title": "Traffic light - Wikipedia",
      "quote": "at night, operated a lever to control the lights"
     }
    ],
    "confidence": "medium"
   },
   {
    "id": "c3",
    "text": "The London signal exploded on 2 January 1869 and was taken down.",
