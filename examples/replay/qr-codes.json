{
  "ResearchDossier": {
    "topic": "why QR codes still scan when damaged",
    "summary": "QR codes, invented in 1994 by Masahiro Hara at Denso Wave to track car parts, carry Reed–Solomon error correction that rebuilds up to ~30% of the code — which is also how logo QR codes work.",
    "angle": "A QR code carries its own spare parts.",
    "claims": [
      {
        "id": "c1",
        "text": "QR codes incorporate Reed–Solomon error correction so the code remains readable even if partially damaged.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/QR_code",
            "title": "QR code - Wikipedia",
            "quote": "to ensure that the code remains readable even if it is partially damaged"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c2",
        "text": "The QR code was invented in 1994 by Masahiro Hara of Denso Wave for labelling and keeping track of automobile parts.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/QR_code",
            "title": "QR code - Wikipedia",
            "quote": "invented in 1994 by Masahiro Hara of the Japanese company Denso Wave"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c3",
        "text": "Error correction was designed for factory labels exposed to oil stains and physical wear that made one-dimensional barcodes unreadable.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/QR_code",
            "title": "QR code - Wikipedia",
            "quote": "exposed to oil stains and physical wear that rendered standard one-dimensional barcodes unreadable"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c4",
        "text": "The design was influenced by the black and white stones of a Go board.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/QR_code",
            "title": "QR code - Wikipedia",
            "quote": "was influenced by the black and white stones played on a Go board"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c5",
        "text": "Three corner finder patterns let the scanner orient the code and work out its perspective.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/QR_code",
            "title": "QR code - Wikipedia"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c6",
        "text": "At the highest level (H), about 30% of codewords can be restored; artistic codes put a logo in the centre and the scanner treats it as damage.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/QR_code",
            "title": "QR code - Wikipedia",
            "quote": "the scanner treats the obscured squares under the logo as a damaged area"
          }
        ],
        "confidence": "high"
      }
    ],
