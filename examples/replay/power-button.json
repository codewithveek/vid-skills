{
 "ResearchDossier": {
  "topic": "the power button symbol",
  "summary": "The ubiquitous power icon (a broken circle with a line) comes from IEC 60417, where it originally meant standby, not on/off.",
  "angle": "The power symbol on your devices originally meant standby, because most devices never fully turn off.",
  "claims": [
   {
    "id": "c1",
    "text": "IEC 60417 defines language-independent graphical symbols for equipment, including power controls.",
    "sources": [
     {
      "url": "https://en.wikipedia.org/wiki/Power_symbol",
      "title": "Power symbol - Wikipedia"
     }
    ],
    "confidence": "high"
   },
   {
    "id": "c2",
    "text": "In IEC 60417 a line means on (5007) and a circle means off (5008).",
    "sources": [
     {
      "url": "https://en.wikipedia.org/wiki/Power_symbol",
      "title": "Power symbol - Wikipedia"
     }
    ],
    "confidence": "high"
   },
   {
    "id": "c3",
    "text": "The broken circle with a line (IEC 60417-5009) is defined as the standby symbol.",
    "sources": [
     {
      "url": "https://en.wikipedia.org/wiki/Power_symbol",
      "title": "Power symbol - Wikipedia"
     }
    ],
    "confidence": "high"
   },
   {
    "id": "c4",
    "text": "A line inside a complete circle (IEC 60417-5010) marks a push-button that toggles power on and off.",
    "sources": [
     {
      "url": "https://en.wikipedia.org/wiki/Power_symbol",
      "title": "Power symbol - Wikipedia"
     }
    ],
    "confidence": "high"
   },
   {
    "id": "c5",
    "text": "IEEE 1621, published in 2004, treats the broken-circle symbol as a generic power symbol and adds a crescent moon for sleep.",
    "sources": [
     {
      "url": "https://en.wikipedia.org/wiki/Power_symbol",
      "title": "Power symbol - Wikipedia"
     }
    ],
    "confidence": "medium"
   },
   {
    "id": "c6",
    "text": "Devices in standby keep drawing a small amount of power, for example to receive remote-control signals.",
    "sources": [
     {
      "url": "https://en.wikipedia.org/wiki/Standby_power",
      "title": "Standby power - Wikipedia"
     }
    ],
    "confidence": "high"
   }
  ],
  "timeline": [
   {
    "year": "2004",
    "event": "IEEE 1621 adds the sleep crescent",
    "claimId": "c5"
   }
  ],
  "analogies": [
   "a doorbell that is always listening",
   "a car idling at a red light"
  ],
  "visualIdeas": [
   "hand holding a TV remote",
   "stereo amplifier switch",
   "standby LED glowing in a dark room"
  ],
  "openQuestions": []
 },
 "Script": {
  "headline": "Your Power Button Isn't Power",
  "cta": "Your power button bends the truth. The follow button won't.",
  "beats": [
