      ],
      "pauseAfterSec": 0.25
     },
     {
      "id": "l5",
      "text": "Its official name was standby.",
      "emphasis": [
       "standby"
      ],
      "claimIds": [
       "c3"
      ],
      "pauseAfterSec": 0.25
     }
    ]
   },
   {
    "id": "b4",
    "kind": "history",
    "musicCue": "none",
    "lines": [
     {
      "id": "l6",
      "text": "A standards body swapped the words on and off for two shapes.",
      "emphasis": [
       "shapes"
      ],
      "claimIds": [
       "c1"
      ],
      "pauseAfterSec": 0.25
     },
     {
      "id": "l7",
      "text": "A line meant on. A circle meant off.",
      "emphasis": [
       "line",
       "circle"
      ],
      "claimIds": [
       "c2"
      ],
      "pauseAfterSec": 0.25
     },
     {
      "id": "l8",
      "text": "Put the line inside the circle, and you get a true on-off switch.",
      "emphasis": [
       "true"
      ],
      "claimIds": [
       "c4"
      ],
      "pauseAfterSec": 0.25
     }
    ]
   },
   {
    "id": "b5",
    "kind": "mechanism",
    "musicCue": "none",
    "lines": [
     {
      "id": "l9",
      "text": "But the broken circle only means the device is lightly asleep.",
      "emphasis": [
       "asleep"
      ],
      "claimIds": [
       "c3"
      ],
      "pauseAfterSec": 0.25
     },
     {
      "id": "l10",
      "text": "It keeps sipping power, listening for your remote.",
      "emphasis": [
       "listening"
      ],
      "claimIds": [
       "c6"
      ],
      "pauseAfterSec": 0.25
     }
    ]
   },
   {
    "id": "b6",
    "kind": "proof",
    "musicCue": "none",
    "lines": [
     {
      "id": "l11",
      "text": "By 2004, a new standard simply called it power.",
      "emphasis": [
       "2004"
      ],
      "claimIds": [
       "c5"
      ],
      "pauseAfterSec": 0.25
     },
     {
      "id": "l12",
      "text": "And added a crescent moon for sleep.",
      "emphasis": [
       "moon"
      ],
      "claimIds": [
       "c5"
      ],
      "pauseAfterSec": 0.25
     }
    ]
   },
   {
    "id": "b7",
    "kind": "payoff",
    "musicCue": "none",
    "lines": [
     {
      "id": "l13",
