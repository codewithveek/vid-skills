  "ResearchDossier": {
    "topic": "where the word OK comes from",
    "summary": "OK began in an 1830s newspaper fad of misspelled abbreviations: 'oll korrect' in the Boston Morning Post, March 1839. The 1840 Van Buren 'Old Kinderhook' campaign kept it alive; Allen Walker Read traced it in 1963–64.",
    "angle": "The world's most used word is a misspelling joke.",
    "claims": [
      {
        "id": "c1",
        "text": "OK has been described as the most frequently spoken or written word on the planet.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/OK",
            "title": "OK - Wikipedia",
            "quote": "the most frequently spoken or written word on the planet"
          }
        ],
        "confidence": "medium"
      },
      {
        "id": "c2",
        "text": "OK originated in an 1830s fad of comical misspellings and acronyms; OW ('oll wright') was a predecessor.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/OK",
            "title": "OK - Wikipedia"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c3",
        "text": "The earliest known printed O.K. is in the 23 March 1839 edition of the Boston Morning Post, as an initialism of 'oll korrect' (all correct).",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/OK",
            "title": "OK - Wikipedia",
            "quote": "the edition of 23 March of the Boston Morning Post"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c4",
        "text": "During the 1840 election, Democratic supporters claimed OK stood for 'Old Kinderhook', a nickname for Martin Van Buren.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/OK",
            "title": "OK - Wikipedia"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c5",
        "text": "Allen Walker Read's six articles in American Speech (1963–64) established the etymology most reference works now give.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/OK",
            "title": "OK - Wikipedia"
          }
        ],
        "confidence": "high"
      }
    ],
