{
  "ResearchDossier": {
    "topic": "where the ampersand comes from",
    "summary": "& is the Latin et written as one shape in Roman cursive. Children once recited it as the 27th letter: '…X, Y, Z, and per se and', slurred into 'ampersand' (common by 1837). The Ampère origin is a myth.",
    "angle": "The & was a letter of the alphabet, and its name is a mispronunciation.",
    "claims": [
      {
        "id": "c1",
        "text": "The ampersand originated as a ligature of the word et (Latin for 'and'), traced to the 1st century CE and old Roman cursive, where E and T were occasionally written together.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Ampersand",
            "title": "Ampersand - Wikipedia",
            "quote": "originated as a ligature of the word et"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c2",
        "text": "& was regarded as the 27th letter of the English alphabet, as taught to children in the US and elsewhere.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Ampersand",
            "title": "Ampersand - Wikipedia",
            "quote": "& was regarded as the 27th letter of the English alphabet"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c3",
        "text": "The character was referred to as 'and per se and' (the symbol by itself, 'and'), which was routinely slurred to 'ampersand'.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Ampersand",
            "title": "Ampersand - Wikipedia",
            "quote": "was routinely slurred to 'ampersand'"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c4",
        "text": "The term 'ampersand' had entered common English usage by 1837.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Ampersand",
            "title": "Ampersand - Wikipedia",
            "quote": "had entered common English usage by 1837"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c5",
        "text": "It has been falsely claimed that André-Marie Ampère used the symbol in his publications and that it was named 'Ampère's and'.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Ampersand",
            "title": "Ampersand - Wikipedia",
            "quote": "falsely claimed that André-Marie Ampère used the symbol"
          }
        ],
        "confidence": "high"
      }
    ],
