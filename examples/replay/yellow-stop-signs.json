  "ResearchDossier": {
    "topic": "why stop signs are red",
    "summary": "US stop signs began in Detroit in 1914 as black-on-white squares, got the octagon in 1922, were yellow from 1924 because red faded, and turned red only in 1954 to match traffic lights.",
    "angle": "The red, the most recognisable thing about a stop sign, is its newest part.",
    "claims": [
      {
        "id": "c1",
        "text": "The first stop sign was created in 1914 by Detroit police sergeant Harold 'Harry' Jackson; the first signs had black lettering on a white background and were 24 by 24 inches.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Stop_sign",
            "title": "Stop sign - Wikipedia",
            "quote": "The first signs had black lettering on a white background and were 24 by 24 inches."
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c2",
        "text": "An AASHO committee meeting in 1922 chose the octagonal shape.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Stop_sign",
            "title": "Stop sign - Wikipedia"
          }
        ],
        "confidence": "medium"
      },
      {
        "id": "c3",
        "text": "The eight-sided shape allows drivers facing the back of the sign to identify that oncoming drivers have a stop sign.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Stop_sign",
            "title": "Stop sign - Wikipedia",
            "quote": "allows drivers facing the back of the sign to identify that oncoming drivers have a stop sign"
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c4",
        "text": "From 1924 to 1954 US stop signs bore a red or black legend on a yellow field; yellow was chosen because fade-resistant red materials were not available.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Stop_sign",
            "title": "Stop sign - Wikipedia",
            "quote": "Yellow was chosen because fade-resistant red materials were not available."
          }
        ],
        "confidence": "high"
      },
      {
        "id": "c5",
        "text": "The 1954 MUTCD specified a white stop legend on a red field, so red signalled stop whether from a sign or a traffic light.",
        "sources": [
          {
            "url": "https://en.wikipedia.org/wiki/Stop_sign",
            "title": "Stop sign - Wikipedia",
            "quote": "The 1954 MUTCD newly specified a white stop legend on a red field"
          }
        ],
        "confidence": "high"
      }
    ],
